    family-names: Zhang
    affiliation: "Zhejiang University of Technology"
repository-code: "https://github.com/iobio-zjut/ForceFlowAb"
license: MIT
keywords:
  - antibody design
  - complementarity-determining regions
  - rectified flow
  - flow matching
  - mixture of experts
